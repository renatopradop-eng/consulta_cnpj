# Copie este arquivo para ".env" e preencha com sua chave real.
# A chave é obtida em https://portal.casadosdados.com.br/plataforma/api/chave
CASADOSDADOS_API_KEY=coloque_sua_chave_aqui

# Ajuste se a Casa dos Dados mudar a versão/URL do endpoint de pesquisa.
CASADOSDADOS_API_URL=https://api.casadosdados.com.br/v5/public/cnpj/pesquisa

# Chave secreta usada pelo Flask para sessão (qualquer texto aleatório).
FLASK_SECRET_KEY=troque-por-um-texto-aleatorio
